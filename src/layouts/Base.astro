---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { company } from "../data/company";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, jsonLd } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(path, site).href : path;
const ogImage = site ? new URL("/brand/logo.png", site).href : "/brand/logo.png";
const pageTitle = path === "/" ? title : `${title} | ${company.name}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1b1916" />
    <meta name="geo.region" content="GB-BDF" />
    <meta name="geo.placename" content="Bedford" />
    <meta name="geo.position" content={`${company.lat};${company.lng}`} />
    <meta name="ICBM" content={`${company.lat}, ${company.lng}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={company.legalName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header path={path} />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <div class="callbar">
      <a href={`tel:${company.phoneTel}`}>Call {company.phoneDisplay}</a>
      <a href="/contact">Get a quote</a>
    </div>
  </body>
</html>
