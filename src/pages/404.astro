---
import Base from "../layouts/Base.astro";

const title = "Page not found";
const description = "That page is not on the Electrotech website. Try the home page or call 01234 325435.";
---

<Base title={title} description={description} path="/404">
  <section class="page-hero">
    <div class="wrap prose">
      <h1>That page is not here</h1>
      <p>The link may be old, or the address may have a typing error.</p>
      <p>
        <a href="/">Go to the home page</a><br />
        <a href="/contact">Contact Electrotech</a><br />
        <a href="/services">See the services</a>
      </p>
    </div>
  </section>
</Base>
